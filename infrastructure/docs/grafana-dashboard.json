{
  "uid": "logistics-gateway-m4",
  "title": "物流聚合平台 - 网关与管理后台监控",
  "tags": ["logistics", "gateway", "m4"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "uid": "prometheus" },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "datasource": { "uid": "-- Grafana --" },
        "enable": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "hide": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "网关请求速率 (RPS)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(ecat_http_requests_total[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "网关 5xx 错误率 (%)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(ecat_http_requests_total{status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(ecat_http_requests_total[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx 占比"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "熔断器 503 速率 (近似熔断状态, 无独立 breaker gauge)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tracking_queries_total{result=\"breaker\"}[$__rate_interval]))",
          "legendFormat": "breaker 503/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(tracking_queries_total{result=\"upstream\"}[$__rate_interval]))",
          "legendFormat": "upstream 502/s"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "管理后台 DB/Redis 连接状态 (1=正常, 0=故障)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.5 }
            ]
          },
          "custom": { "drawStyle": "lines", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "open_admin_db_up", "legendFormat": "DB" },
        { "refId": "B", "expr": "open_admin_redis_up", "legendFormat": "Redis" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "管理后台用户数 (活跃/总数)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "open_admin_active_users", "legendFormat": "今日活跃" },
        { "refId": "B", "expr": "open_admin_total_users", "legendFormat": "注册总数" }
      ]
    }
  ]
}
